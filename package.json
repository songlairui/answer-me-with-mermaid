{
  "name": "answer-me-with-mermaid",
  "version": "0.1.0",
  "description": "An agent skill that makes the model answer with standard Mermaid diagrams, validated and rendered offline by Pele.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "amm": "./skills/answer-me-with-mermaid/scripts/amm.mjs"
  },
  "scripts": {
    "build": "esbuild src/cli.js --bundle --platform=node --format=esm --target=node20 --outfile=skills/answer-me-with-mermaid/scripts/amm.mjs --legal-comments=inline --banner:js=\"#!/usr/bin/env node\"",
    "dev": "node src/cli.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pele": "^1.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": ["mermaid", "pele", "agent-skill", "diagram", "svg"]
}
